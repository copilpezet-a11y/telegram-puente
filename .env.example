# Copia este archivo como .env y escribe el token de tu bot de Telegram.
# .env NO se sube al repositorio.

# Token que te da @BotFather al crear el bot (parecido a 123456789:AA...).
TELEGRAM_BOT_TOKEN=

# ── IA (OpenRouter) ──
# Key de https://openrouter.ai/keys. Con UNA key accedes a muchos modelos.
IA_API_KEY=

# Modelo a usar (cámbialo cuando quieras sin tocar el código).
# Algunos ejemplos: openai/gpt-4o-mini · anthropic/claude-3.5-sonnet ·
#                   google/gemini-2.0-flash-exp:free · meta-llama/llama-3.3-70b-instruct
IA_MODELO=meta-llama/llama-3.3-70b-instruct